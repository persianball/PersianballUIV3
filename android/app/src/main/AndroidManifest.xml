<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- اندروید ۱۳ به بالا برای نمایش نوتیفیکیشن اجازه‌ی صریح می‌خواهد -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="پرشین بال"
        android:name="${applicationName}"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Deep link support: custom scheme and HTTPS -->
        <activity-alias
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <!-- سرور فعلی: http روی IP و پورت ۸۰۰۰.
                 autoVerify اینجا عمداً نیست چون App Links تأییدشده به
                 assetlinks.json روی دامنه HTTPS نیاز دارد و روی IP ممکن نیست؛
                 بدون آن، اندروید هنگام باز کردن لینک اپ را پیشنهاد می‌دهد. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="2.144.27.195" android:port="8000" />
                <data android:scheme="https" android:host="2.144.27.195" android:port="8000" />
            </intent-filter>

            <!-- دامنه نهایی؛ پس از راه‌اندازی HTTPS و قرار دادن
                 /.well-known/assetlinks.json لینک‌ها بدون انتخاب کاربر باز می‌شوند -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="api2.persianball.ir" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Custom scheme -->
                <data android:scheme="marketky" />
            </intent-filter>
        </activity-alias>

        <!-- کانال پیش‌فرض؛ بدون آن، پیام‌های بدون channel_id روی اندروید ۸+
             در کانالِ «Miscellaneous» می‌افتند. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="persianball_default" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility   and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!-- اضافه کردن queries برای دسترسی به اپلیکیشن‌های خارجی -->
    <queries>
        <!-- برای باز کردن مرورگر -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- برای تماس -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- برای ارسال ایمیل -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- اگر می‌خوای اپ خاصی مثل تلگرام رو باز کنی -->
        <package android:name="org.telegram.messenger" />
    </queries>
</manifest>